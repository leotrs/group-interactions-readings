# The simulated benchmark. Results go to outputs/, or to the folder in $STUDY_OUTPUTS.
# The saved results are in outputs/, so `just all` recomputes only what is missing.
# `just fresh` recomputes everything into a new folder; `just verify` checks a few runs
# against the saved results in about a minute.

out := env_var_or_default("STUDY_OUTPUTS", "outputs")

# List the recipes
default:
    @just --list

# Run the tests
test:
    uv run pytest -q

# Tune the world's rates for a number of people met per day (default: main setting)
tune people_met="6.0":
    nice -n 20 uv run python tune.py {{people_met}}

# Run one setting ("main" or e.g. "detection_probability=0.25"), skipping finished runs
run setting="main" jobs="3":
    uv run python run.py {{setting}} {{jobs}}

# Tune every number of people met per day in the sweep, then run all 14 settings
sweep jobs="3":
    for x in 6.0 3.0 10.0 25.0; do \
        test -f {{out}}/tuned/people_met_per_day=$x.json || just tune $x; \
    done
    uv run python run.py sweep {{jobs}}

# Print the results of one setting, or "sweep" for the winners in every setting
report setting="main":
    uv run python report.py {{setting}}

# Draw Figure 1, Figure 2 and the figure of Supplementary File S2
figures:
    uv run python design_figure.py
    uv run python figures.py main

# Recompute the tuning and three runs, and check them against the saved results
verify:
    nice -n 20 uv run python verify.py

# Tests, then the tuning and runs that are missing, the report and the figures
all jobs="3": test (sweep jobs) (report "sweep") figures

# Everything from scratch into outputs_fresh/ (about an hour with 3 processes)
fresh jobs="3":
    STUDY_OUTPUTS=outputs_fresh just all {{jobs}}
