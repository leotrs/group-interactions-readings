# Implementation checks: exposure statistics and the remedy fits, on 3 seeds.
check:
    nice -n 20 uv run python check.py

# The 20 runs of the main setting (3 worker processes), then the report.
run:
    nice -n 20 uv run python main.py 20
    uv run python report.py

# Print the report from saved results and rewrite RESULTS.md.
report:
    uv run python report.py
